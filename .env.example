# Copiar a backend/.env y ajustar. Valores de ejemplo solo para desarrollo local.
DB_URL=jdbc:mysql://localhost:3306/ferreteria?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Santiago
DB_USER=ferreteria
DB_PASSWORD=ferreteria
DB_ROOT_PASSWORD=root
# Clave para firmar los JWT: al menos 32 caracteres. En una instalación real, genera una propia
# (por ejemplo con: openssl rand -base64 48)
JWT_SECRET=cambia-esta-clave-por-una-propia-de-al-menos-32-caracteres
# Duración de la sesión en minutos (usa 1 o 2 para demostrar la expiración)
JWT_EXPIRATION_MINUTES=60
CORS_ORIGINS=http://localhost:5173
